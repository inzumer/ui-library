{
  "name": "@cysur/ui",
  "version": "0.1.0",
  "private": false,
  "description": "React UI component library for the Cysur design system",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button/index.d.ts",
      "import": "./dist/components/Button/index.js"
    },
    "./input": {
      "types": "./dist/components/Input/index.d.ts",
      "import": "./dist/components/Input/index.js"
    },
    "./card": {
      "types": "./dist/components/Card/index.d.ts",
      "import": "./dist/components/Card/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cysur/tokens": "workspace:*"
  },
  "peerDependencies": {
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "react": ">=18 || ^19",
    "react-dom": ">=18 || ^19",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@cysur/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "^25.0.1",
    "tailwind-merge": "2.6.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
